# ── EdgeRadar environment ────────────────────────────────────────────────
# Provider selection:
#   DATA_PROVIDER=sofascore     → SofaScore live feed (real current dates, no API key required)
#   DATA_PROVIDER=api-football  → API-Football (requires APIFOOTBALL_KEY)
#   DATA_PROVIDER=football-data → football-data.org (requires FOOTBALL_DATA_API_KEY)
#   DATA_PROVIDER=demo          → force synthetic demo data (clearly labeled)
#   unset                       → auto: API-Football if key set, else football-data.org if key set, else DEMO
DATA_PROVIDER=

# ── API-Football (api-sports.io) — free key: https://dashboard.api-football.com
# FREE plan: 100 req/day, old seasons only → app runs labeled REPLAY mode.
# PRO plan ($19/mo): current season, corners/cards/odds become available.
APIFOOTBALL_KEY=
# Comma-separated league IDs (default: 14 curated majors, e.g. 39=EPL, 140=La Liga)
APIFOOTBALL_LEAGUES=
# Season start-year override (default: auto-detect, walks back on free plans)
APIFOOTBALL_SEASON=
# Cache TTL minutes (default 360 — keeps free plan inside 100 req/day)
APIFOOTBALL_TTL_MINUTES=
# Corners/cards enrichment: extra requests per warm cycle (default 0 = off;
# on Pro try 50-100 — fetched once per fixture, cached permanently)
APIFOOTBALL_STATS_BUDGET=
# Set to 0 to disable the labeled replay mode on old-season (free) data
APIFOOTBALL_REPLAY=

# ── football-data.org — free key: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Display timezone for all kickoff times (default Africa/Lagos)
DISPLAY_TZ=Africa/Lagos

# PostgreSQL (Prisma) — see prisma/schema.prisma
DATABASE_URL=postgresql://user:pass@localhost:5432/edgeradar
