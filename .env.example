# ── EdgeRadar environment ─────────────────────────────────────────────────────
# Exactly ONE provider serves the app. Demo and live data are never mixed, and
# requesting a live provider without its credentials is a hard configuration
# error (ProviderConfigError) — it never silently downgrades to demo data.
#
#   DATA_PROVIDER=custom         → your own JSON API   (CUSTOM_API_URL [+ CUSTOM_API_KEY])
#   DATA_PROVIDER=api-football   → API-Football        (APIFOOTBALL_KEY)
#   DATA_PROVIDER=football-data  → football-data.org   (FOOTBALL_DATA_API_KEY)
#   DATA_PROVIDER=openfootball   → OpenFootball        (no key required)
#   DATA_PROVIDER=demo           → synthetic demo data (clearly labeled on every screen)
#
# Unset → auto-detected in the order above (openfootball only when
# OPENFOOTBALL_ENABLED=1), falling back to demo when nothing is configured.
DATA_PROVIDER=

# ── Custom Football API ───────────────────────────────────────────────────────
# Either variable works; CUSTOM_API_URL wins when both are set.
CUSTOM_API_URL=
CUSTOM_FOOTBALL_API_URL=
# Sent as both `Authorization: Bearer <key>` and `x-api-key: <key>`. Optional.
CUSTOM_API_KEY=
# Optional overrides
CUSTOM_API_CACHE_MINUTES=15
CUSTOM_API_DATA_PATH=/data
CUSTOM_API_FIXTURES_PATH=/fixtures
CUSTOM_API_ODDS_PATH=

# ── API-Football (https://dashboard.api-football.com) ────────────────────────
APIFOOTBALL_KEY=
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_TTL_MINUTES=360
APIFOOTBALL_LEAGUES=
APIFOOTBALL_SEASON=

# ── football-data.org (https://www.football-data.org/client/register) ────────
FOOTBALL_DATA_API_KEY=
FDO_BASE_URL=https://api.football-data.org/v4

# ── OpenFootball (https://github.com/openfootball/football.json) ──────────────
# No API key. Set OPENFOOTBALL_TZ to the zone the published times are in —
# the datasets carry no timezone, so the default (UTC) can shift kickoff labels.
OPENFOOTBALL_ENABLED=0
OPENFOOTBALL_BASE_URL=https://raw.githubusercontent.com/openfootball/football.json/master
OPENFOOTBALL_LEAGUES=en.1,es.1,it.1,de.1,fr.1
OPENFOOTBALL_SEASONS=
OPENFOOTBALL_TZ=UTC
OPENFOOTBALL_CACHE_MINUTES=60

# ── Display ───────────────────────────────────────────────────────────────────
# Timezone for every kickoff label and for the "Today"/"Tomorrow" day boundaries.
DISPLAY_TZ=Africa/Lagos

# ── Optional ──────────────────────────────────────────────────────────────────
ODDS_API_KEY=

# PostgreSQL (Prisma) — see prisma/schema.prisma
DATABASE_URL=postgresql://user:pass@localhost:5432/edgeradar
